#!/usr/bin/env bash
# git-safe-push — the ONLY sanctioned way to push a Tau Ceti PR branch.
#
# This is the [HARD] write arbiter (coordination contract §1): every PR-branch update goes through a
# branch-level compare-and-swap, so we NEVER silently overwrite another agent's work — cooperating or
# not — and we detect the race and bail. It does NOT depend on anyone honoring claims.
#
#   git push --force-with-lease=<ref>:<expected>  origin HEAD:<ref>
#     expected = <oid>  → succeeds iff the remote branch still equals the oid we observed at checkout
#     expected = ""     → create-only (succeeds iff the branch does not exist) — for authoring
#
# If a claim is in play, it is re-checked/renewed immediately before the push and the push FAILS CLOSED
# if the lease was lost (someone took over). The claim is [COOP] (avoids duplicate work); the branch CAS
# is what actually protects the write.
#
# Inputs (exported by the worker before it launches the agent; the agent just runs `git-safe-push [<branch>]`):
#   TAUCETI_PUSH_REF     destination branch on the head repo (or pass as $1)
#   TAUCETI_PUSH_EXPECT  observed remote head oid; empty/unset ⇒ create-only (new branch)
#   TAUCETI_PUSH_REMOTE  git remote or URL to push to (default: origin)
#   TAUCETI_CLAIM_KEY    optional claim key to verify/renew before pushing
#   TAUCETI_CLAIM_REPO   repository containing that claim (default: claim.sh's normal selection)
#   TAUCETI_CLAIM_SH     path to claim.sh (default: alongside this script)
set -uo pipefail

REF="${1:-${TAUCETI_PUSH_REF:-}}"
EXPECT="${TAUCETI_PUSH_EXPECT:-}"
REMOTE="${TAUCETI_PUSH_REMOTE:-origin}"
CLAIM_KEY="${TAUCETI_CLAIM_KEY:-}"
CLAIM_REPO_OVERRIDE="${TAUCETI_CLAIM_REPO:-}"
CLAIM_SH="${TAUCETI_CLAIM_SH:-$(cd "$(dirname "$0")" && pwd)/claim.sh}"
CHECK=""

die() { echo "git-safe-push: $*" >&2; exit 1; }
claim() {
    if [[ -n "$CLAIM_REPO_OVERRIDE" ]]; then
        CLAIM_REPO="$CLAIM_REPO_OVERRIDE" "$CLAIM_SH" "$@"
    else
        "$CLAIM_SH" "$@"
    fi
}
check_claim() {
    if [[ -n "$CLAIM_KEY" ]]; then
        [[ -x "$CLAIM_SH" ]] || die "claim ownership could not be verified: helper unavailable; refusing to push"
        claim holds "$CLAIM_KEY" >/dev/null 2>&1; holds_rc=$?
        if [[ "$holds_rc" -ne 0 ]]; then
            claim renew "$CLAIM_KEY" >/dev/null 2>&1; renew_rc=$?
            [[ "$renew_rc" -eq 0 ]] || die \
                "claim ownership could not be verified (holds rc=$holds_rc, renew rc=$renew_rc) — refusing to push"
        fi
    fi
}
# Do not spend a validation run after losing ownership.
check_claim
# Host rounds bind these values before launching the agent. A login shell or an
# agent's mistaken `TAUCETI_PUSH_REMOTE=origin` must not redirect a fork repair.
# Unbound callers (including Bubble) retain the existing environment contract.
POLICY="$(git rev-parse --git-path tauceti-publication)" || die "publication policy location unreadable"
if [[ -e "$POLICY" ]]; then
    REMOTE="$(git config --file "$POLICY" --get publication.remote)" || die "bound remote unreadable"
    bound_ref="$(git config --file "$POLICY" --get publication.ref)" || die "bound ref unreadable"
    EXPECT="$(git config --file "$POLICY" --get publication.expect)" || die "bound expected head unreadable"
    CHECK="$(git config --file "$POLICY" --get publication.check)" || die "bound check unreadable"
    [[ -z "$bound_ref" || -z "$REF" || "$REF" == "$bound_ref" ]] || die "destination differs from the admitted PR branch"
    REF="${bound_ref:-$REF}"
fi
[[ -n "$REMOTE" ]] || die "no destination remote"
[[ -n "$REF" ]] || die "no destination branch (set TAUCETI_PUSH_REF or pass it as an argument)"

# The checker runs synchronously against the commit that will actually be pushed.
# It owns project-specific build/lint/audit commands and their terminal evidence.
# Check again after it returns: a green result for a different HEAD is not valid.
CANDIDATE="$(git rev-parse --verify HEAD)" || die "candidate HEAD unreadable"
if [[ -n "$CHECK" ]]; then
    [[ "$CHECK" = /* && -x "$CHECK" ]] || die "configured pre-push check is unavailable"
    dirty="$(git status --porcelain)" || die "candidate status unreadable"
    [[ -z "$dirty" ]] || die "commit the candidate before running publication validation"
    "$CHECK" || die "candidate validation failed; no push attempted"
    [[ "$(git rev-parse --verify HEAD)" == "$CANDIDATE" ]] || die "candidate changed during validation; no push attempted"
    dirty="$(git status --porcelain)" || die "candidate status unreadable after validation"
    [[ -z "$dirty" ]] || die "candidate became dirty during validation; no push attempted"
fi

# Validation may take time; verify the lease again immediately before pushing.
if [[ -n "$CHECK" ]]; then check_claim; fi

# 2) Branch-level CAS push. expected="" ⇒ create-only; else must still equal the observed oid.
echo "git-safe-push: $REMOTE HEAD:$REF (--force-with-lease=$REF:${EXPECT:-<create-only>})" >&2
if git push --force-with-lease="$REF:$EXPECT" "$REMOTE" "$CANDIDATE:$REF"; then
    if [[ -n "${TAUCETI_PUBLISHED_HEAD_FILE:-}" ]]; then
        printf '%s\n' "$CANDIDATE" >>"$TAUCETI_PUBLISHED_HEAD_FILE" \
            || die "push succeeded but its publication receipt could not be written"
    fi
    exit 0
fi
die "push failed; inspect Git's diagnostic above. A permission/transport failure is not a branch race.
Only a stale-info/rejected lease establishes a compare-and-swap refusal. Preserve the candidate,
verify the destination and remote head, and do not retry a plain 'git push'."
