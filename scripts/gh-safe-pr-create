#!/usr/bin/env bash
# gh-safe-pr-create — the ONLY sanctioned way to open a Tau Ceti PR (authoring path).
#
# Verifies the author target claim is still held (fail closed if another agent took the target), then
# runs `gh pr create` with the given args. The branch must already have been pushed via git-safe-push
# (which create-only-pushes it, so two agents can't both create the same branch). It also checks the
# PR body carries the machine-readable target marker the dup-sweeper relies on (coordination contract §4).
#
# Inputs:
#   TAUCETI_AUTHOR_CLAIM_KEY   the author/<area>/<target-id> claim acquired in shell before the agent ran
#   TAUCETI_TARGET_MARKER      the exact <!--tauceti-target:v1 {...}--> string the PR body must contain
#   TAUCETI_CLAIM_SH           path to claim.sh (default: alongside this script)
# All `gh pr create` flags pass through unchanged.
set -uo pipefail

CLAIM_KEY="${TAUCETI_AUTHOR_CLAIM_KEY:-}"
MARKER="${TAUCETI_TARGET_MARKER:-}"
REQUIRE_MARKER="${TAUCETI_REQUIRE_TARGET_MARKER:-}"   # 1 ⇒ body must carry SOME <!--tauceti-target--> marker
BODY_FORMAT="${TAUCETI_PR_BODY_FORMAT:-}"             # spinrep-v1 ⇒ enforce the established SpinRep body
CLAIM_SH="${TAUCETI_CLAIM_SH:-$(cd "$(dirname "$0")" && pwd)/claim.sh}"

die() { echo "gh-safe-pr-create: $*" >&2; exit 1; }

# extract the PR body from the passed `gh pr create` flags (--body/-b <s>, --body-file/-F <f>).
pr_body_from_args() {
    local b="" prev=""
    for a in "$@"; do
        case "$prev" in
            --body|-b) b="$a";;
            --body-file|-F) [[ -f "$a" ]] && b="$(cat "$a")";;
        esac
        prev="$a"
    done
    printf '%s' "$b"
}

# SpinRep's body is deliberately checked at the only public-creation choke point.  This is opt-in so
# the shared Worker remains compatible with older projects, while every SpinRep seed worker can fail
# closed before an abbreviated body reaches GitHub.
validate_spinrep_body() {
    local body="$1" footer
    [[ "$body" == "This PR "* ]] \
        || die "SpinRep PR body must open with a concise 'This PR …' summary"
    grep -qE '^Roadmap:[[:space:]]+[^[:space:]].*$' <<<"$body" \
        || die "SpinRep PR body must contain a standalone 'Roadmap: <area>' line"
    for section in "## Summary" "## Roadmap target" "## Verification" "## Scale and generality" "## Scope"; do
        grep -qxF "$section" <<<"$body" \
            || die "SpinRep PR body is missing the required section '$section'"
    done
    for field in Consumes Provides Fits Boundary; do
        grep -qE "^- \\*\\*${field}:\\*\\*[[:space:]]+[^[:space:]].*$" <<<"$body" \
            || die "SpinRep PR body is missing the non-empty Scope bullet '${field}'"
    done
    grep -qE '<!--tauceti-target:v1 \{[^}]*"id"[[:space:]]*:[[:space:]]*"[^"]+"[^}]*\}-->' <<<"$body" \
        || die "SpinRep PR body is missing its target marker"
    footer="$(awk 'NF { last=$0 } END { print last }' <<<"$body")"
    [[ "$footer" == '<sub>🤖 GPT-5.6 Sol high '* ]] \
        || die "SpinRep PR body must end with the GPT-5.6 Sol/high provenance footer"
    for project in TauCetiWorker TauCetiReview formal-land; do
        [[ "$footer" == *"$project"* ]] || die "SpinRep provenance footer is missing '$project'"
    done
    grep -qE 'TauCetiWorker @ \[[0-9a-f]{7,40}\]\(https://github\.com/utensil/TauCetiWorker/commit/[0-9a-f]{7,40}\)' <<<"$footer" \
        || die "SpinRep footer needs a real TauCetiWorker commit link"
    grep -qE 'rubrics @ \[[0-9a-f]{7,40}\]\(https://github\.com/utensil/TauCetiReview/commit/[0-9a-f]{7,40}\)' <<<"$footer" \
        || die "SpinRep footer needs a real TauCetiReview rubrics commit link"
    grep -qE 'local review @ \[[0-9a-f]{7,40}\]\(https://github\.com/utensil/formal-land/commit/[0-9a-f]{7,40}\)' <<<"$footer" \
        || die "SpinRep footer needs a real local-review skill commit link"
    ! grep -qE 'ut-lean-golf|provider error|unknown_error' <<<"$body" \
        || die "SpinRep PR body must not contain golf provenance or provider-error text"
    grep -qE 'fixed:[[:space:]]+[^;]+;[[:space:]]+addressed:[[:space:]]+[^<]+' <<<"$footer" \
        || die "SpinRep footer needs fixed then addressed rubric lists"
    local fixed_list addressed_list
    fixed_list="${footer#*fixed: }"
    fixed_list="${fixed_list%%; addressed:*}"
    addressed_list="${footer#*; addressed: }"
    addressed_list="${addressed_list%%</sub>*}"
    [[ "$fixed_list" == "$addressed_list" ]] \
        || die "SpinRep footer requires fixed and addressed to name the same rubric set"
    ! grep -qE '\[(WORKER_SHA|RUBRICS_SHA|REVIEW_SKILL_SHA|GOLF_SHA|canonical roadmap area|claimed-target-slug)\]' <<<"$body" \
        || die "SpinRep PR body still contains an unreplaced template placeholder"
    ! grep -qF '\n' <<<"$body" \
        || die "SpinRep PR body contains a literal newline escape"
}

# 1) Author claim must still be ours (else another agent is authoring this target — abandon).
if [[ -n "$CLAIM_KEY" && -x "$CLAIM_SH" ]]; then
    "$CLAIM_SH" holds "$CLAIM_KEY" \
        || die "author lease '$CLAIM_KEY' lost (another agent took the target) — do NOT create the PR"
fi

# 2) The PR body must carry the target marker so the conservative dup-sweeper can match it.
#    Either an EXACT marker is mandated (TAUCETI_TARGET_MARKER, when the shell pre-picked the target),
#    or just SOME well-formed marker is required (TAUCETI_REQUIRE_TARGET_MARKER, agent-picked target).
if [[ -n "$MARKER" ]]; then
    body="$(pr_body_from_args "$@")"
    [[ "$body" == *"$MARKER"* ]] \
        || die "PR body is missing the required target marker:
  $MARKER
Add it to the PR body (it lets other agents and the dup-sweeper recognize this target)."
elif [[ "$REQUIRE_MARKER" == "1" ]]; then
    body="$(pr_body_from_args "$@")"
    grep -qE '<!--tauceti-target:v1 \{[^}]*"id"[[:space:]]*:[[:space:]]*"[^"]+"[^}]*\}-->' <<<"$body" \
        || die "PR body is missing a target marker. Add a line like:
  <!--tauceti-target:v1 {\"focus\":\"<area>\",\"id\":\"<slug>\"}-->
It lets other agents and the dup-sweeper recognize which roadmap target this PR authors."
fi

if [[ "$BODY_FORMAT" == "spinrep-v1" ]]; then
    body="$(pr_body_from_args "$@")"
    validate_spinrep_body "$body"
fi

echo "gh-safe-pr-create: gh pr create $*" >&2
# Keep the normal gh URL output for the agent, while recording only the resulting PR number in the
# host-provided per-round inbox. The inbox is a receipt consumed by the Worker host; it is not the
# durable ownership record. A missing/failed receipt is surfaced as an error rather than silently
# creating an unowned PR that another maintenance Worker could pick up.
if [[ -n "${TAUCETI_PR_RECEIPT_FILE:-}" ]]; then
    output="$(gh pr create "$@" 2>&1)"
    rc=$?
    printf '%s\n' "$output"
    (( rc == 0 )) || exit "$rc"
    url="$(grep -Eo 'https://github\.com/[^[:space:]]+/pull/[1-9][0-9]*' <<<"$output" | tail -1)"
    [[ -n "$url" ]] || die "gh pr create succeeded but returned no PR URL; ownership was not recorded"
    number="${url##*/}"
    printf '%s\n' "$number" >>"$TAUCETI_PR_RECEIPT_FILE" \
        || die "gh pr create succeeded but could not write the ownership receipt"
    exit 0
fi
exec gh pr create "$@"
